  "_meta": {
    "description": "TutorSnap master test registry. Each entry tracks a test case with its feature area, the commit/PR that introduced it, and its current status. Add a new entry whenever a test is added — CI uses this to tag reports and detect coverage gaps.",
    "schema_version": "1.0",
    "fields": {
      "id":          "Unique stable ID (never reuse a retired ID)",
      "name":        "Human-readable test name",
      "file":        "Path relative to backend/tests/",
      "class":       "pytest class (null for module-level tests)",
      "function":    "pytest function name",
      "marker":      "Primary pytest marker (matches pytest.ini markers)",
      "feature":     "Short feature name / domain",
      "added_in":    "Git commit SHA or PR number that introduced this test",
      "status":      "active | skip | xfail"
    }
  },

